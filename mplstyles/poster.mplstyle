# From https://github.com/jonathanoesterle/data_plots/tree/master
axes.spines.bottom : True
axes.spines.left : True
axes.spines.top : False
axes.spines.right : False
axes.linewidth : 1.5

xtick.major.width : 1.2
ytick.major.width : 1.2
xtick.minor.width : 1.0
ytick.minor.width : 1.0
xtick.major.size : 5
ytick.major.size : 5
xtick.minor.size : 2.5
ytick.minor.size : 2.5
font.size : 24
axes.titlesize : 34
axes.labelsize : 24
legend.fontsize : 24
legend.title_fontsize : 24
xtick.labelsize : 24
ytick.labelsize : 24
xtick.major.pad : 6
ytick.major.pad : 6
savefig.facecolor : (1, 1, 1, 1)
savefig.dpi : 300
font.family : sans-serif
font.sans-serif : Arial
font.serif : Times New Roman

mathtext.fontset : custom
mathtext.default : cal
mathtext.cal : DejaVu Sans
mathtext.rm : Arial
mathtext.sf : Arial
mathtext.tt : Arial

legend.borderaxespad : 0.2
legend.borderpad : 0.0
legend.columnspacing : 0.2
legend.frameon : False
legend.handlelength : 1.8
legend.handletextpad : 0.3
legend.labelspacing : 0.1
legend.loc : upper right

figure.dpi : 60.  # only affects the notebook
figure.facecolor : (1, 1, 1, 1)  # only affects the notebook